 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c8",
  "field": "fees",
  "text": "화성(행궁 및 화령전) 개인 요금은 어른 2,000원, 군인·청소년 1,500원, 어린이 1,000원이다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8",
   "https://www.suwon.go.kr/sw-www/sw-visitsuwon/sw-visitsuwon-01/sw-visitsuwon-01-02/sw-visitsuwon-01-02-01.jsp"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c9",
  "field": "fees",
  "text": "20인 이상 단체 요금은 어른 1,500원, 군인·청소년 1,200원, 어린이 800원이다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c10",
  "field": "fees",
  "text": "화성행궁, 수원화성박물관, 수원박물관 3종 통합관람권은 개인 어른 4,000원, 군인·청소년 2,500원, 어린이 1,000원이다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8",
   "https://www.suwon.go.kr/sw-www/sw-visitsuwon/sw-visitsuwon-01/sw-visitsuwon-01-02/sw-visitsuwon-01-02-01.jsp"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c11",
  "field": "fees",
  "text": "매달 마지막 주 수요일 문화가 있는 날에는 화성행궁이 무료이나 야간개장은 제외된다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c12",
  "field": "fees",
  "text": "한복(개량한복 포함) 착용자는 관람료 면제·감면 대상이며, 65세 이상(신분증 소지), 6세 이하 취학 전 아동, 장애인복지법상 해당자(중증은 돌보는 사람 1명 포함)는 관람료가 전액 면제된다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8",
   "https://www.suwon.go.kr/sw-www/sw-visitsuwon/sw-visitsuwon-01/sw-visitsuwon-01-02/sw-visitsuwon-01-02-01.jsp"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c13",
  "field": "fees",
  "text": "수원시민 대상 감면도 있다: 두 자녀 이상 동반한 다자녀가정은 전액 면제(수원시민 한정), 수원시 청년(19~39세)은 매주 금요일 면제.",
  "sources": [
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c14",
  "field": "hours",
  "text": "2026년 야간개장은 5월 1일(금)부터 11월 1일(일)까지 매주 금~일요일과 공휴일 18:00~21:30이며 입장 마감은 21:00이다.",
  "sources": [
   "https://www.swcf.or.kr/?p=392",
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c15",
  "field": "fees",
  "text": "야간개장 입장료는 어른 2,000원, 청소년·군인 1,500원, 어린이 1,000원이며 한복 착용자, 만 6세 이하, 만 65세 이상은 무료이다.",
  "sources": [
   "https://www.swcf.or.kr/?p=392"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c16",
  "field": "caution",
  "text": "수원화성문화제(10.4~10.11) 기간에는 야간개장 운영이 바뀔 수 있고, 야간개장 기간은 재단 사정에 따라 변경될 수 있다.",
  "sources": [
   "https://www.suwon.go.kr/sw-www/sw-visitsuwon/sw-visitsuwon-01/sw-visitsuwon-01-02/sw-visitsuwon-01-02-01.jsp",
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
  "place": "kr-gyeonggi-suwon-hwaseong",
  "name": "수원화성",
  "cid": "r1-b08-c17",
  "field": "caution",
  "text": "화성행궁에는 위험물, 주류, 텐트·돗자리 등 야영용품, 취사도구, 반려동물(장애인 보조견 제외), 확성기 등을 가지고 들어갈 수 없다.",
  "sources": [
   "https://www.swcf.or.kr/?p=8"
  ]
 },
 {
