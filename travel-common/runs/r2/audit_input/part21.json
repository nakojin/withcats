  ]
 },
 {
  "place": "kr-gyeongbuk-andong-hahoe-village",
  "name": "안동 하회마을",
  "cid": "r1-b06-c2",
  "field": "location",
  "text": "하회마을 관리사무소의 주소는 안동시 풍천면 하회리 전서로 186-10이다.",
  "sources": [
