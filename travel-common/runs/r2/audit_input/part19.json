[
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c6",
  "field": "access",
  "text": "지하철 1호선 토성역 6번 출구(부산대병원)에서 마을버스 서구2, 서구2-2, 사하구1-1로 환승한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c7",
  "field": "access",
  "text": "지하철 1호선 자갈치역 1번 출구(충무시장 정류장)에서도 같은 마을버스(서구2, 서구2-2, 사하구1-1)로 환승한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c8",
  "field": "parking",
  "text": "공영 주차장은 두 곳이다. 사하구 옥천로 130 부산교육역사관 지하(78면)와 사하구 감내1로175번길 5(40면)이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c9",
  "field": "parking",
  "text": "공식 안내는 주차장이 부족하니 대중교통을 이용하라고 권하고, 대형버스는 예약시스템으로 사전 예약해야 한다고 적는다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c10",
  "field": "parking",
  "text": "마을 홈페이지에는 주차 예약 메뉴가 있으며, 방문일·시간·차량 대수·인원을 선택해 예약하고 기본 이용 시간은 90분이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/group-tour-reservation"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c11",
  "field": "parking",
  "text": "한국관광공사 영문 안내는 주차가 가능하며 무료라고 표기한다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=72894"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c12",
  "field": "hours",
  "text": "마을안내센터 운영시간은 09:00~18:00이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c13",
  "field": "closed_days",
  "text": "마을안내센터는 연중무휴다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro4"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c14",
  "field": "hours",
  "text": "특별관리지역 주거 밀집지역은 방문 시간이 09:00~18:00이며 시행일은 2027년 1월 1일이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c15",
  "field": "caution",
  "text": "2026년 8월 1일 특별관리지역으로 지정·고시되었고 시행일은 2027년 1월 1일이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c16",
  "field": "caution",
  "text": "10인 이상 단체 방문객은 방문객 지도를 의무 구입해야 하며 2026년 8월 1일부터 시행 중이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c17",
  "field": "access",
  "text": "관광객 탑승 차량(택시 포함)은 감내2로에서 통행이 제한되며, 제한 시간은 09:00~18:00, 구간은 안내센터 입구에서 추억의 그림자 포토존까지 약 1km다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c18",
  "field": "caution",
  "text": "통행 제한 위반 과태료는 2028년 1월 1일부터 부과하며 2026년 8월 1일부터 2027년 12월 31일까지는 계도 기간이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c19",
  "field": "reservation",
  "text": "대형버스는 사전 예약제를 실시한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c20",
  "field": "caution",
  "text": "불법 주정차, 무단 투기, 소음, 사생활 침해 행위를 관리한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/api/user/intro1-content/pdf/ko/download"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c21",
  "field": "caution",
  "text": "마을 공지는 드론 촬영을 금지한다(No drones).",
  "sources": [
   "https://www.gamcheon.or.kr/"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c22",
  "field": "caution",
  "text": "주민이 실제로 사는 마을이므로 일상을 존중하고 서로 배려해 달라고 안내한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro1"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c23",
  "field": "duration",
  "text": "사하구 추천 메인도로 왕복 코스는 마을안내센터에서 바다포토존까지 40분 걸린다.",
  "sources": [
   "https://eulsukdo.saha.go.kr/tour/contents.do?mId=0101010000"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c24",
  "field": "duration",
  "text": "알짜 코스와 스탬프 코스는 각각 1시간 20분이 걸린다.",
  "sources": [
   "https://eulsukdo.saha.go.kr/tour/contents.do?mId=0101010000"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c25",
  "field": "highlight",
  "text": "마을안내센터는 관광정보와 편의공간을 제공하며 골목투어 지도 판매, 물품 보관소 운영, 마을 해설사 소개를 한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro2"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c26",
  "field": "highlight",
  "text": "하늘마루는 부산항과 감천항을 함께 내려다보는 전망대 겸 전시 안내관이다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro2"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c27",
  "field": "highlight",
  "text": "작은박물관에서는 주민이 모은 옛 사진과 생활용품, 2009년 마을미술프로젝트부터 이어진 마을 조성 과정을 볼 수 있다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro2"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c28",
  "field": "reservation",
  "text": "체험 프로그램은 운영시간이 시작 기준 09:00~16:00이고 전화(051-291-1444)로 접수하며 당일 예약은 안 되고 당월부터 3개월 이내까지 예약할 수 있다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/program"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c29",
  "field": "payment",
  "text": "체험 프로그램은 예약일 3일 전까지 전액 환불, 2일 전~1일 전은 50% 환불이며 당일 취소나 무단 불참은 환불이 제한될 수 있다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/refund"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c30",
  "field": "fees",
  "text": "한국관광공사 영문 안내는 요금을 무료(Free)로 표기한다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=72894"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c31",
  "field": "language",
  "text": "마을 공식 사이트와 소개 PDF는 한국어, 영어, 중국어, 일본어를 제공한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro1"
  ]
 },
 {
  "place": "kr-busan-gamcheon-culture-village",
  "name": "감천문화마을",
  "cid": "r1-b11-c32",
  "field": "tip",
  "text": "입주작가 공방은 총 9곳(도자기, 천연염색, 생태공예, 서양화, 카툰, 판화, 회화 2곳, 설치예술)이며, 방문을 원하면 사전에 연락하라고 안내한다.",
  "sources": [
   "https://www.gamcheon.or.kr/gamcheon/page/user/intro2"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c1",
  "field": "location",
  "text": "광안리해수욕장 주소는 부산광역시 수영구 광안해변로 219 (광안동)이다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=8bb0d877-5238-423d-8b3e-4f2dff0066da",
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c2",
  "field": "hours",
  "text": "광안리해수욕장은 24시간 상시 개방된다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=8bb0d877-5238-423d-8b3e-4f2dff0066da",
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c3",
  "field": "closed_days",
  "text": "휴무일 없이 연중무휴이다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=8bb0d877-5238-423d-8b3e-4f2dff0066da"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c4",
  "field": "fees",
  "text": "광안리해수욕장 이용은 무료이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c5",
  "field": "parking",
  "text": "한국관광공사 영문 안내는 주차 가능, 10분당 300원이라고 적고 있다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c6",
  "field": "description",
  "text": "해변은 해운대해수욕장 서쪽에 있으며 길이 1.4km, 폭 25~110m이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c7",
  "field": "description",
  "text": "여름에는 해수욕과 서핑·패들보드 같은 해양 레저를 즐길 수 있고, 해변을 따라 카페와 맛집이 밀집해 있으며 공연·축제·드론쇼가 열린다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=8bb0d877-5238-423d-8b3e-4f2dff0066da"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c8",
  "field": "tip",
  "text": "저녁에 광안대교의 조명이 빛나는 모습을 보러 오는 사람이 많다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=111074"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c9",
  "field": "location",
  "text": "광안대교는 수영구 남천동에서 해운대구 우동 센텀시티까지 7.4km 이상 이어진다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c10",
  "field": "location",
  "text": "광안대교의 한국관광공사 등록 주소는 부산광역시 해운대구 수영강변대로 203이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c11",
  "field": "description",
  "text": "광안대교는 국내에서 가장 긴 해상 이중(2층) 교량이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c12",
  "field": "highlight",
  "text": "수천 개의 LED 조명이 밤마다 계절에 따라 달라지는 조명 연출을 한다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c13",
  "field": "hours",
  "text": "광안대교는 24시간 운영(개방)으로 안내된다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c14",
  "field": "parking",
  "text": "광안대교에는 주차 시설이 없다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c15",
  "field": "tip",
  "text": "광안대교 문의처는 부산시설공단 +82-51-780-0077이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=91002"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c16",
  "field": "highlight",
  "text": "광안리 M 드론 라이트쇼는 매주 토요일 저녁 광안리 해변에서 열리며 드론 1,100대가 하루 두 차례 공연한다. 명절·새해 카운트다운 등 특별한 날에는 최대 3,000대로 커진다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=194990"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c17",
  "field": "hours",
  "text": "드론쇼 공연 시각은 3~9월 20:00·22:00, 10~2월 19:00·21:00이며 날씨에 따라 바뀔 수 있다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=194990"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c18",
  "field": "duration",
  "text": "드론쇼는 회당 약 12분이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=194990"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c19",
  "field": "fees",
  "text": "드론쇼 관람은 무료이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=194990"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c20",
  "field": "tip",
  "text": "드론쇼 공식 사이트는 gwangallimdrone.co.kr, 문의는 +82-51-610-4882이며 주최는 부산광역시 수영구이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=194990"
  ]
 },
 {
  "place": "kr-busan-gwangalli-bridge-overview",
  "name": "광안리·광안대교",
  "cid": "r1-b02-c21",
  "field": "tip",
  "text": "무장애 정보: 광안리해수욕장 출입구는 턱이 없어 휠체어 접근이 가능하고, 장애인 화장실과 여자화장실 내 기저귀교환대가 있다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=8bb0d877-5238-423d-8b3e-4f2dff0066da"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c1",
  "field": "location",
  "text": "해동용궁사의 도로명 주소는 부산광역시 기장군 기장읍 용궁길 86이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618",
   "https://www.gijang.go.kr/tour/index.gijang?menuCd=DOM_000000306001001000"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c2",
  "field": "fees",
  "text": "입장료는 무료이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c3",
  "field": "parking",
  "text": "주차가 가능하다고 안내되어 있다(요금은 해당 페이지에 없음).",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c4",
  "field": "parking",
  "text": "장애인 주차구역이 5대 있다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=6e8a6f87-f917-4424-9a26-87e92435f3bd"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c6",
  "field": "hours",
  "text": "VISITKOREA 무장애 관광정보 페이지(수정일 2026-08-18)에는 이용시간이 04:30~20:30으로 안내되어 있다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=6e8a6f87-f917-4424-9a26-87e92435f3bd"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c7",
  "field": "closed_days",
  "text": "휴무일 없이 연중무휴로 안내되어 있다.",
  "sources": [
   "https://access.visitkorea.or.kr/ms/detail.do?cotId=6e8a6f87-f917-4424-9a26-87e92435f3bd",
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c8",
  "field": "tip",
  "text": "문의 전화는 051-722-7744이고 사찰 누리집은 www.yongkungsa.or.kr 이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c9",
  "field": "description",
  "text": "해동용궁사는 1376년 고려의 나옹대사가 창건했고 임진왜란 때 소실된 뒤 1930년대 초 통도사의 운강이 중창했다.",
  "sources": [
   "https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=2116b628-ded9-42c2-b17e-99d17b5b65e4"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c10",
  "field": "description",
  "text": "1974년 정암 스님이 백일기도 중 흰옷의 관세음보살이 용을 타고 승천하는 꿈을 꾸어 절 이름을 해동용궁사로 바꾸었다.",
  "sources": [
   "https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=2116b628-ded9-42c2-b17e-99d17b5b65e4"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c11",
  "field": "highlight",
  "text": "대부분의 한국 사찰이 산에 있는 것과 달리 바닷가에 자리한 사찰이다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=108618"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c12",
  "field": "highlight",
  "text": "대웅전 옆 굴법당(미륵전)의 미륵좌상 석불은 득남불로 불리며, 대웅전 앞에는 사사자 석탑이 있다.",
  "sources": [
   "https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=2116b628-ded9-42c2-b17e-99d17b5b65e4"
  ]
 },
 {
  "place": "kr-busan-haedong-yonggungsa",
  "name": "해동용궁사",
  "cid": "r1-b10-c13",
  "field": "highlight",
  "text": "현존 건물로 대웅전, 굴법당, 용왕당(용궁단), 범종각, 요사채가 있다.",
  "sources": [
   "https://korean.visitkorea.or.kr/detail/ms_detail.do?cotid=2116b628-ded9-42c2-b17e-99d17b5b65e4"
  ]
 }
]