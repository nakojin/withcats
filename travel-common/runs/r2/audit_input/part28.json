[
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c7",
  "field": "duration",
  "text": "궁궐전각 관람은 약 60분, 약 1km 코스이다(돈화문-금천교-궐내각사-인정전-선정전-희정당-대조전-낙선재).",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c8",
  "field": "duration",
  "text": "후원(왕실정원) 관람은 약 90분, 약 2.5km이며 7~8월과 12~2월에는 약 70분으로 줄여 운영한다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c9",
  "field": "hours",
  "text": "후원 한국어 해설 관람은 2~11월 10:00~15:00 매시 정각, 3~10월은 16:00 회차가 추가된다(방문 시점 10월은 16:00까지).",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25",
   "https://english.visitseoul.net/area/2024-cdggarden/ENPl8f5md"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c10",
  "field": "language",
  "text": "후원 외국어 해설은 영어 3~11월 10:30·11:30·14:30·15:30(12~2월은 15:30 제외), 중국어 화·목·토 12:30, 일본어 수·금·일 13:30이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c11",
  "field": "language",
  "text": "궁궐전각 무료 해설은 한국어 11~2월 9:30·11:30·13:30·15:30, 3~10월은 16:30 추가이며 영어 10:15·13:15, 중국어(화·목·토) 10:00, 일본어(수·금·일) 11:00, 러시아어(수) 10:45이다. 소요 약 50분, 집결지는 돈화문 안쪽 안내도 앞이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c12",
  "field": "language",
  "text": "음성안내기는 한국어·영어·일본어·중국어로 3,000원에 빌릴 수 있고, 후원은 제외된 전각 지역용이다. 돈화문 밖 왼편 안내데스크에서 신분증을 맡기고 빌리며 건물 번호를 직접 입력하는 방식이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=/watch_info/palacesCdgConvInst.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c13",
  "field": "fees",
  "text": "궁궐전각 입장료는 내국인 대인(만25~64세) 3,000원, 외국인 대인(만19~64세) 3,000원이며 유료 10인 이상 단체는 2,400원이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25",
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c14",
  "field": "fees",
  "text": "궁궐전각 외국인 소인(만7~18세) 요금은 1,500원(유료 10인 이상 단체 1,200원)이며, 내국인 만7~24세는 무료이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c15",
  "field": "fees",
  "text": "무료 대상은 내국인 만6세 이하, 만7~24세, 만65세 이상, 한복 착용자, 매월 마지막 수요일(문화가 있는 날) 등이다. 외국인도 만6세 이하, 만65세 이상, 한복 착용자는 무료이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c16",
  "field": "fees",
  "text": "만65세 이상·만24세 이하 내국인은 정문 신분증 인식기(주민등록증·운전면허증만 가능)로 티켓 없이 입장할 수 있다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c17",
  "field": "fees",
  "text": "후원(왕실정원) 특별관람료는 성인(만19세 이상) 5,000원, 소인(만7~18세) 2,500원이며 궁궐전각 관람권을 별도로 사야 한다. 전각 요금은 내국인 만25~64세·외국인 만19~64세 3,000원, 외국인 소인 1,500원이고 내국인 만24세 이하와 만65세 이상은 무료이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25",
   "https://english.visitseoul.net/area/2024-cdggarden/ENPl8f5md"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c18",
  "field": "fees",
  "text": "궁궐 통합관람권은 10,000원이며 구매일로부터 3개월간 쓸 수 있고 각 궁 1회 한정이다(국가유산청 창덕궁 페이지 기준).",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c19",
  "field": "reservation",
  "text": "후원은 해설사 인솔 하의 제한관람으로 회당 100명(온라인 예매 50명, 현장 발권 50명), 선착순이다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25",
   "https://english.visitseoul.net/area/2024-cdggarden/ENPl8f5md"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c20",
  "field": "reservation",
  "text": "후원 온라인 예매는 관람희망일 6일 전 오전 10시부터 하루 전까지 선착순이며 1인당 10명까지 가능하다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c21",
  "field": "reservation",
  "text": "청소년(초·중·고) 단체는 관람희망일 하루 전까지 홈페이지로 신청해야 하며 예매는 180일 전부터 가능하다. 통합관람권을 사도 후원은 당일 매표소에서 현장 구매표로 교환해야 한다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c22",
  "field": "caution",
  "text": "후원은 입장시간을 지키지 않으면 입장과 관람권 교환·환불이 안 된다. 궁궐 입구에서 후원 입구까지 15분 넘게 걸리므로 시작 최소 20분 전에 돈화문으로 입장해야 한다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c23",
  "field": "caution",
  "text": "후원은 개별 관람이 불가하고 가이드 인솔 관람만 가능하다. 외국어 해설 회차에는 내국인이 참여할 수 없고, 외국인 동반 시에만 내국인 최대 2명이 입장할 수 있다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c24",
  "field": "caution",
  "text": "창덕궁 전 구역이 금연이고 음식물, 주류, 돗자리·텐트·그늘막, 취사도구 반입이 금지되며 안내견 외 애완동물은 출입할 수 없다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=/watch_info/palacesCdgViewRule.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c25",
  "field": "caution",
  "text": "해설 중 동영상 촬영·녹음은 문화재해설사의 사전 승인 없이는 할 수 없다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=/watch_info/palacesCdgViewRule.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c26",
  "field": "tip",
  "text": "짐은 돈화문 안쪽 왼편 물품보관소에 맡길 수 있고, 24개월 이하 유아용 유모차와 휠체어(각 10대·6대)는 돈화문 안쪽 왼편 초소에서 무료로 빌릴 수 있다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=/watch_info/palacesCdgConvInst.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c27",
  "field": "description",
  "text": "1405년 태종 때 지어졌고 임진왜란 뒤 1610년(광해군 2년)에 재건되어 약 270년 동안 조선의 왕궁으로 쓰였다.",
  "sources": [
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c28",
  "field": "description",
  "text": "서울에서 두 번째로 유네스코 세계유산에 올랐고, 동아시아 궁궐 건축사에서의 아름다움과 자연환경과의 배치가 뛰어나 대표 궁궐로 선정되었다.",
  "sources": [
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c29",
  "field": "highlight",
  "text": "후원(왕실정원)은 부용지, 애련지, 연경당, 관람지, 옥류천을 지나는 코스이며 창덕궁의 약 60%를 차지한다.",
  "sources": [
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296",
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide2.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c30",
  "field": "tip",
  "text": "궁궐전각 일반 관람은 인정전과 낙선재를 중심으로 하는 기본 코스이다.",
  "sources": [
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c31",
  "field": "tip",
  "text": "금·토·일에는 심화 해설 '창덕궁 깊이보기'가 있다: 궐내각사는 10:30, 낙선재는 14:30이며 사전 예약과 현장 참여가 모두 가능하다.",
  "sources": [
   "https://www.cha.go.kr/html/HtmlPage.do?pg=%2Fwatch_info%2FpalacesCdgGuide1.jsp&mn=NS_01_25"
  ]
 },
 {
  "place": "kr-seoul-changdeokgung",
  "name": "창덕궁",
  "cid": "r1-b02-c32",
  "field": "tip",
  "text": "창덕궁 문의 전화는 02-3668-2300이다.",
  "sources": [
   "https://english.visitseoul.net/attractions/changdeokgung%20palace%20_/296"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c1",
  "field": "location",
  "text": "명동은 서울특별시 중구 명동2가 일대에 있다.",
  "sources": [
   "https://www.junggu.seoul.kr/english/content.do?cmsid=14885",
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c2",
  "field": "access",
  "text": "지하철 4호선 명동역 5~10번 출구가 접근 지점으로 안내된다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c3",
  "field": "access",
  "text": "두 주요 거리 중 하나는 4호선 명동역에서, 다른 하나는 을지로의 롯데백화점에서 시작해 블록 중앙에서 만난다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c4",
  "field": "hours",
  "text": "매일 운영하며 영업시간은 점포마다 다르다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c5",
  "field": "closed_days",
  "text": "서울 공식 관광 사이트는 명동을 매일 연다(Open daily)고 표기하며, 영업시간은 점포마다 다르다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c6",
  "field": "description",
  "text": "서울 공식 관광 사이트는 명동을 서울의 쇼핑 메카이자 상업·금융·문화의 중심지로, 낮 시간 인구가 150만~200만 명이라고 소개한다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c7",
  "field": "highlight",
  "text": "거리 노점과 일반 매장이 섞여 있고 한국 화장품 매장이 많다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c8",
  "field": "highlight",
  "text": "약 1km 길이의 거리에 눈스퀘어, 롯데백화점, 신세계백화점 등 대형 쇼핑센터와 국내외 브랜드 매장이 모여 있다.",
  "sources": [
   "https://www.junggu.seoul.kr/english/content.do?cmsid=14885"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c9",
  "field": "highlight",
  "text": "한국관광공사는 남대문·동대문과 달리 명동에 디자이너 브랜드가 많이 입점해 있다고 설명한다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c10",
  "field": "highlight",
  "text": "명동에는 돈가스와 칼국수를 내는 식당이 많다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c11",
  "field": "language",
  "text": "중구청은 명동 상인들이 영어뿐 아니라 중국어와 일본어로도 응대하며, 명동 거리가 다양한 언어 서비스를 제공한다고 안내한다.",
  "sources": [
   "https://www.junggu.seoul.kr/english/content.do?cmsid=14885"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c12",
  "field": "language",
  "text": "한국관광공사 1330 여행 핫라인(+82-2-1330)은 한국어, 영어, 일본어, 중국어로 상담한다.",
  "sources": [
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c13",
  "field": "caution",
  "text": "일본·중국의 황금연휴(봄)에는 일본·중국 관광객이 몰려 붐빈다고 서울 공식 관광 사이트가 적는다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067"
  ]
 },
 {
  "place": "kr-seoul-myeongdong",
  "name": "명동",
  "cid": "r1-b11-c14",
  "field": "tip",
  "text": "문의 전화는 다산콜 +82-2-120(서울 공식 관광 사이트)과 +82-2-778-0333(한국관광공사 페이지)이 안내된다.",
  "sources": [
   "https://english.visitseoul.net/shopping/Myeong-dong/ENP000067",
   "https://english.visitkorea.or.kr/svc/whereToGo/locIntrdn/rgnContentsView.do?vcontsId=88011"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c1",
  "field": "location",
  "text": "N서울타워의 주소는 서울 용산구 남산공원길 105이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c2",
  "field": "description",
  "text": "전망대는 해발 400m 높이로 서울을 한눈에 조망할 수 있고, 엘리베이터가 미디어아트로 꾸며져 있다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/observatory.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c3",
  "field": "description",
  "text": "전망대는 360도 파노라마 뷰로 서울을 감상하는 공간이라고 소개된다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/observatory.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c4",
  "field": "hours",
  "text": "전망대 운영시간은 평일 10:00~22:30, 주말·공휴일 10:00~23:00이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c5",
  "field": "hours",
  "text": "전망대는 마감시간 30분 전까지 입장할 수 있고, 영업시간은 기후 상황 및 운영 일정에 따라 변경될 수 있다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c6",
  "field": "closed_days",
  "text": "N서울타워는 1년 365일 연중무휴이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c7",
  "field": "fees",
  "text": "전망대 요금은 대인(만 13세 이상) 29,000원, 소인(만 3세~만 12세) 23,000원이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use2.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c8",
  "field": "fees",
  "text": "만 65세 이상 경로 대상은 소인 요금과 같고, 36개월 미만 유아는 무료이다(보호자 1명당 1명).",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use2.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c9",
  "field": "fees",
  "text": "장애인 1~3급은 본인과 동반자 1인 30%, 4~6급은 본인 30% 할인되며(패키지·단체 제외) 국가유공자는 본인 30% 할인이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/use2.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c10",
  "field": "fees",
  "text": "서울시티투어버스 가이드북 내 쿠폰을 제시하면 전망대 10% 할인을 받을 수 있다고 FAQ에 안내되어 있다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=3"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c11",
  "field": "reservation",
  "text": "전망대는 별도 예약 없이 당일 입장권을 구매해 입장한다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=2"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c12",
  "field": "reservation",
  "text": "레스토랑은 예약하면 더 편리하며, 엔그릴은 사전 예약 시 전망대 무료입장 혜택이 있고 한쿡 이용 시 전망대 입장 금액을 할인받는다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=2"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c13",
  "field": "tip",
  "text": "입장권은 N서울타워 Plaza 5F 안내데스크와 TOWER 1F 티켓부스에서 살 수 있고(5층에는 무인발권기도 있음), 티켓은 구매 당일에만 쓸 수 있다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=1",
   "https://www.nseoultower.co.kr/visit/floor.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c14",
  "field": "payment",
  "text": "전망대에서는 CJ상품권, 국민관광상품권, 해피21/해피머니 제휴 상품권을 쓸 수 있으며, 상품권은 현금으로 바꿔 주지 않고 액면가의 60% 이상(1만원 이하는 80%) 사용 시 잔액을 현금으로 돌려준다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=2"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c15",
  "field": "access",
  "text": "남산 생태 보호를 위해 2005년 5월 1일부터 일반 승용차 통행이 제한되어, 방문 시 01A·01B 남산 순환버스, 서울시티투어버스, 인근 주차장 주차 후 순환버스·도보를 이용해야 한다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/traffic.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c16",
  "field": "access",
  "text": "01A 남산 순환버스는 충무로역(3·4호선)·동대입구역(3호선)에서 탈 수 있고 배차 간격 9분, 운영 06:30~23:00, 요금 1,500원(환승 가능)이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/traffic.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c17",
  "field": "access",
  "text": "01B 남산 순환버스(구 8001번)도 충무로역·동대입구역에서 탈 수 있고 배차 간격 14분, 운영 06:30~23:00, 요금 1,500원이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/traffic.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c18",
  "field": "access",
  "text": "경유(디젤) 관광버스는 남산예장버스환승주차장에 주차한 뒤 순환버스를 이용해야 한다(2021년 8월부터 남산 순환로 진입 제한).",
  "sources": [
   "https://www.nseoultower.co.kr/visit/traffic.asp"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c19",
  "field": "access",
  "text": "장애인 등록증(복지카드 1~3급)이 차량에 부착되어 있으면 차량 통행이 허용된다.",
  "sources": [
   "https://www.nseoultower.co.kr/global/customer/faq.asp?page=2"
  ]
 },
 {
  "place": "kr-seoul-n-seoul-tower",
  "name": "N서울타워(남산)",
  "cid": "r1-b03-c20",
  "field": "access",
  "text": "남산케이블카는 명동역(4호선) 3번 출구에서 퍼시픽호텔 오른쪽 길을 따라 도보 10분이며, 운영시간은 10:00~23:00이다.",
  "sources": [
   "https://www.nseoultower.co.kr/visit/traffic2.asp"
  ]
 }
]